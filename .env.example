DATABASE_URL="postgresql://user:password@localhost:5432/ngopbis?schema=public"
SESSION_SECRET="replace-with-at-least-32-characters"

# Optional persistent upload directory. In EasyPanel mount a volume here.
UPLOAD_DIR="/app/public/uploads"

# Public app URL used for Open Graph image previews when sharing event links.
NEXT_PUBLIC_APP_URL="https://your-domain.com"


# Optional WAHA integration
WAHA_API_URL=""
WAHA_SESSION="default"
WAHA_API_KEY=""
